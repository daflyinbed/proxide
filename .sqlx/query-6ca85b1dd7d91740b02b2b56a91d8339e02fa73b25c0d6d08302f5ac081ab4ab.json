  "query": "SELECT DISTINCT p.id, p.name, p.scope, p.description, p.source, p.access,\n                      p.abbreviated_dist_id, p.full_dist_id\n               FROM packages p\n               JOIN organizations o ON o.name = p.scope\n               WHERE o.id = ?\n               ORDER BY p.id",
